# ──────────────────────────────────────────────
# HOA – Healthcare Operations Assistant
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Postgres ──
POSTGRES_USER=hoa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hoa
DATABASE_URL=postgresql+psycopg://hoa:changeme@db:5432/hoa

# ── Security ──
JWT_SECRET=change-me-to-a-random-64-char-string
AUDIT_HMAC_KEY=change-me-to-a-random-64-char-string
VAULT_KEY=                        # 32-byte url-safe base64 Fernet key

# ── LLM ──
LLM_PROVIDER=template            # mistral | template
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_FAST_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
EMBED_DIM=1024

# ── App ──
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=info
